<sf:PageBase
  x:Class="Starshot.Features.Screenshot.ClipboardPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:lang="using:Starshot.Language"
  xmlns:local="using:Starshot.Features.Screenshot"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:mxi="using:Microsoft.Xaml.Interactivity"
  xmlns:sc="using:Starshot.Controls"
  xmlns:sf="using:Starshot.Frameworks"
  xmlns:sh="using:Starshot.Helpers"
  xmlns:ui="using:CommunityToolkit.WinUI"
  x:DefaultBindMode="OneWay"
  mc:Ignorable="d"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <TextBlock
      Margin="24,0,0,0"
      HorizontalAlignment="Left"
      VerticalAlignment="Center"
      FontSize="20"
      FontWeight="Bold"
      Text="{x:Bind lang:Lang.Common_Clipboard}"
    />

    <!--  当前剪贴板：内容过大未进系统历史时的实时展示（与历史第一条相同则隐藏，永不重复）  -->
    <Border
      x:Name="Border_CurrentClipboard"
      Grid.Row="1"
      Margin="24,12,24,0"
      Padding="20,12"
      HorizontalAlignment="Stretch"
      sh:PointerCursor.CursorShape="Hand"
      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="8"
      Tapped="Border_CurrentClipboard_Tapped"
      Visibility="Collapsed"
    >
      <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <sc:CachedImage
          x:Name="CachedImage_Current"
          Width="200"
          Height="112"
          VerticalAlignment="Center"
          Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
          CornerRadius="4"
          Stretch="UniformToFill"
        />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
          <TextBlock
            FontSize="16"
            FontWeight="SemiBold"
            Text="{x:Bind lang:Lang.ClipboardPage_CurrentClipboard}"
          />
          <TextBlock
            x:Name="TextBlock_CurrentDims"
            FontSize="13"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          />
          <TextBlock
            FontSize="12"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Text="{x:Bind lang:Lang.ClipboardPage_NotInHistory}"
          />
        </StackPanel>
      </Grid>
    </Border>

    <GridView
      x:Name="GridView_Images"
      Grid.Row="2"
      Padding="24,16,12,12"
      IsItemClickEnabled="True"
      ItemClick="GridView_Images_ItemClick"
      ItemsSource="{x:Bind Items}"
      SelectionChanged="GridView_Images_SelectionChanged"
      SelectionMode="None"
    >
      <GridView.ItemContainerStyle>
        <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
          <Setter Property="Margin" Value="0,0,12,12" />
          <Setter Property="CornerRadius" Value="4" />
        </Style>
      </GridView.ItemContainerStyle>
      <GridView.ItemsPanel>
        <ItemsPanelTemplate>
          <ItemsWrapGrid ItemHeight="128" ItemWidth="218" Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </GridView.ItemsPanel>
      <GridView.ItemTemplate>
        <DataTemplate x:DataType="local:ScreenshotItem">
          <Grid
            Name="Grid_ImageItem"
            sh:PointerCursor.CursorShape="Hand"
            ui:UIElementExtensions.ClipToBounds="True"
            DataContextChanged="Grid_ImageItem_DataContextChanged"
          >
            <sc:CachedImage
              Name="Image_Thumb"
              Width="206"
              Height="116"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              ui:VisualExtensions.NormalizedCenterPoint="0.5"
              Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
              RenderTransformOrigin="0.5,0.5"
              Source="{x:Bind ThumbImage}"
              Stretch="UniformToFill"
            >
              <sc:CachedImage.RenderTransform>
                <ScaleTransform />
              </sc:CachedImage.RenderTransform>
            </sc:CachedImage>
            <Grid.Resources>
              <CircleEase x:Key="CircleEase" EasingMode="EaseOut" />
              <Storyboard x:Key="GridZoomInStoryboard">
                <DoubleAnimation
                  EasingFunction="{StaticResource CircleEase}"
                  Storyboard.TargetName="Image_Thumb"
                  Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                  To="1.15"
                  Duration="0:0:0.3"
                />
                <DoubleAnimation
                  EasingFunction="{StaticResource CircleEase}"
                  Storyboard.TargetName="Image_Thumb"
                  Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                  To="1.15"
                  Duration="0:0:0.3"
                />
              </Storyboard>
              <Storyboard x:Key="GridZoomOutStoryboard">
                <DoubleAnimation
                  EasingFunction="{StaticResource CircleEase}"
                  Storyboard.TargetName="Image_Thumb"
                  Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                  To="1"
                  Duration="0:0:0.6"
                />
                <DoubleAnimation
                  EasingFunction="{StaticResource CircleEase}"
                  Storyboard.TargetName="Image_Thumb"
                  Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                  To="1"
                  Duration="0:0:0.6"
                />
              </Storyboard>
            </Grid.Resources>
            <mxi:Interaction.Behaviors>
              <mxi:EventTriggerBehavior EventName="PointerEntered">
                <mxi:ControlStoryboardAction Storyboard="{StaticResource GridZoomInStoryboard}" />
              </mxi:EventTriggerBehavior>
              <mxi:EventTriggerBehavior EventName="PointerExited">
                <mxi:ControlStoryboardAction Storyboard="{StaticResource GridZoomOutStoryboard}" />
              </mxi:EventTriggerBehavior>
            </mxi:Interaction.Behaviors>
          </Grid>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>

    <!-- 空状态：未开启剪贴板历史 -->
    <StackPanel
      x:Name="StackPanel_NotEnabled"
      Grid.Row="2"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Spacing="12"
      Visibility="Collapsed"
    >
      <FontIcon
        FontSize="48"
        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
        Glyph="&#xE77F;"
      />
      <TextBlock
        HorizontalAlignment="Center"
        FontSize="14"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        Text="{x:Bind lang:Lang.ClipboardPage_NotEnabled}"
      />
      <HyperlinkButton
        HorizontalAlignment="Center"
        Content="{x:Bind lang:Lang.ClipboardPage_GoToSettings}"
        Click="Hyperlink_Settings_Click"
      />
    </StackPanel>

    <!-- 空状态：开了但没图片 -->
    <StackPanel
      x:Name="StackPanel_NoImages"
      Grid.Row="2"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Spacing="12"
      Visibility="Collapsed"
    >
      <FontIcon
        FontSize="48"
        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
        Glyph="&#xE77F;"
      />
      <TextBlock
        HorizontalAlignment="Center"
        FontSize="14"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        Text="{x:Bind lang:Lang.ClipboardPage_NoImages}"
      />
    </StackPanel>

    <StackPanel
      Margin="0,0,28,0"
      HorizontalAlignment="Right"
      VerticalAlignment="Center"
      Orientation="Horizontal"
      Spacing="12"
    >
      <TextBlock
        x:Name="TextBlock_SelectCount"
        VerticalAlignment="Center"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        Text="{x:Bind SelectCountText}"
      />
      <ToggleButton
        x:Name="ToggleButton_MultiSelect"
        Content="{x:Bind lang:Lang.ScreenshotPage_MultiSelect}"
        IsChecked="{x:Bind MutliSelect, Mode=TwoWay}"
      />
      <Button
        x:Name="Button_Refresh"
        Click="Button_Refresh_Click"
        Content="{x:Bind lang:Lang.Common_Refresh}"
      />
    </StackPanel>
  </Grid>
</sf:PageBase>
