<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase
  x:Class="Starshot.Features.Setting.ScreenshotSetting"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:cwc="using:CommunityToolkit.WinUI.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:lang="using:Starshot.Language"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:sf="using:Starshot.Frameworks"
  x:DefaultBindMode="OneWay"
  mc:Ignorable="d"
>
  <ScrollViewer Padding="0">
    <StackPanel Width="820" Padding="36,24,36,36" Spacing="20">
      <TextBlock
        FontSize="28"
        FontWeight="Bold"
        Text="{x:Bind lang:Lang.Starshot_Nav_Screenshot}"
      />

      <!--  格式与质量  -->
      <StackPanel Spacing="12">
        <TextBlock FontSize="20" Text="{x:Bind lang:Lang.Starshot_SDRFormat}" />
        <cwc:Segmented SelectedIndex="{x:Bind ScreenshotSDRFormat, Mode=TwoWay}">
          <cwc:SegmentedItem Content="PNG" />
          <cwc:SegmentedItem Content="AVIF" />
          <cwc:SegmentedItem Content="JPEG XL" />
        </cwc:Segmented>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock FontSize="20" Text="{x:Bind lang:Lang.Starshot_HDRFormat}" />
        <cwc:Segmented SelectedIndex="{x:Bind ScreenshotHDRFormat, Mode=TwoWay}">
          <cwc:SegmentedItem Content="AVIF" />
          <cwc:SegmentedItem Content="JPEG XL" />
          <cwc:SegmentedItem Content="PNGv3" />
        </cwc:Segmented>
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBlock FontSize="20" Text="{x:Bind lang:Lang.Starshot_Quality}" />
        <cwc:Segmented SelectedIndex="{x:Bind ScreenshotQuality, Mode=TwoWay}">
          <cwc:SegmentedItem Content="{x:Bind lang:Lang.GameSettingPage_Medium}" />
          <cwc:SegmentedItem Content="{x:Bind lang:Lang.GameSettingPage_High}" />
          <cwc:SegmentedItem Content="{x:Bind lang:Lang.ScreenshotSetting_Lossless}" />
        </cwc:Segmented>
      </StackPanel>

      <StackPanel Spacing="6">
        <ToggleSwitch
          IsOn="{x:Bind EnableScreenshotColorManagement, Mode=TwoWay}"
          OffContent="{x:Bind lang:Lang.ScreenshotSetting_ColorManagement}"
          OnContent="{x:Bind lang:Lang.ScreenshotSetting_ColorManagement}"
        />
        <TextBlock
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Text="{x:Bind lang:Lang.Starshot_ColorManagementDesc}"
          TextWrapping="Wrap"
        />
      </StackPanel>

      <!--  HDR 处理  -->
      <StackPanel Spacing="12">
        <ToggleSwitch
          IsOn="{x:Bind AutoSaveUltraHDRJpeg, Mode=TwoWay}"
          OffContent="{x:Bind lang:Lang.ScreenshotSetting_AutoConvertToSDRImage}"
          OnContent="{x:Bind lang:Lang.ScreenshotSetting_AutoConvertToSDRImage}"
        />
        <TextBlock
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Text="{x:Bind lang:Lang.Starshot_AutoConvertSDRDesc}"
          TextWrapping="Wrap"
        />
        <ToggleSwitch
          IsOn="{x:Bind DeleteHDRIfSDRContent, Mode=TwoWay}"
          OffContent="{x:Bind lang:Lang.Starshot_DeleteHDRIfSDR}"
          OnContent="{x:Bind lang:Lang.Starshot_DeleteHDRIfSDR}"
        />
        <TextBlock
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Text="{x:Bind lang:Lang.Starshot_DeleteHDRIfSDRDesc}"
          TextWrapping="Wrap"
        />
      </StackPanel>

      <!--  自动复制  -->
      <ToggleSwitch
        IsOn="{x:Bind AutoCopyScreenshotToClipboard, Mode=TwoWay}"
        OffContent="{x:Bind lang:Lang.ScreenshotSetting_AutoCopyScreenshotFile}"
        OnContent="{x:Bind lang:Lang.ScreenshotSetting_AutoCopyScreenshotFile}"
      />

      <!--  SDR 白基准  -->
      <StackPanel Spacing="6">
        <TextBlock FontSize="20" Text="{x:Bind lang:Lang.ScreenshotSetting_SdrWhiteLevel}" />
        <TextBlock
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Text="{x:Bind lang:Lang.ScreenshotSetting_SdrWhiteLevelDesc}"
          TextWrapping="Wrap"
        />
        <TextBlock
          x:Name="TextBlock_DisplaySdrWhite"
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextWrapping="Wrap"
        />
        <StackPanel Orientation="Horizontal">
          <ToggleSwitch
            IsOn="{x:Bind SdrWhiteLevelCustomize, Mode=TwoWay}"
            OffContent="{x:Bind lang:Lang.ScreenshotSetting_SdrWhiteLevelCustomize}"
            OnContent="{x:Bind lang:Lang.ScreenshotSetting_SdrWhiteLevelCustomize}"
          />
          <NumberBox
            Width="150"
            VerticalAlignment="Center"
            IsEnabled="{x:Bind SdrWhiteLevelCustomize}"
            Maximum="1000"
            Minimum="80"
            SmallChange="10"
            SpinButtonPlacementMode="Compact"
            Value="{x:Bind SdrWhiteLevelValue, Mode=TwoWay}"
          />
        </StackPanel>
      </StackPanel>

      <!--  捕获显示器  -->
      <StackPanel Spacing="12">
        <TextBlock FontSize="20" Text="{x:Bind lang:Lang.Starshot_MonitorSource}" />
        <cwc:Segmented SelectedIndex="{x:Bind CaptureMonitorSource, Mode=TwoWay}">
          <cwc:SegmentedItem Content="{x:Bind lang:Lang.Starshot_MonitorForeground}" />
          <cwc:SegmentedItem Content="{x:Bind lang:Lang.Starshot_MonitorCursor}" />
        </cwc:Segmented>
      </StackPanel>

      <!--  信息浮窗  -->
      <StackPanel Spacing="12">
        <TextBlock FontSize="20" Text="{x:Bind lang:Lang.ScreenshotSetting_InfoWindow}" />
        <ToggleSwitch
          IsOn="{x:Bind ShowScreenshotInfoWindow, Mode=TwoWay}"
          OffContent="{x:Bind lang:Lang.ScreenshotSetting_ShowScreenshotInfoWindow}"
          OnContent="{x:Bind lang:Lang.ScreenshotSetting_ShowScreenshotInfoWindow}"
        />
        <StackPanel Spacing="12" Visibility="{x:Bind InfoWindowOptionsVisibility}">
          <TextBlock Margin="0,12,0,0" Text="{x:Bind lang:Lang.AppearanceSetting_InfoWindowDuration}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <NumberBox
              Width="150"
              Maximum="30000"
              Minimum="500"
              SmallChange="500"
              SpinButtonPlacementMode="Compact"
              Value="{x:Bind InfoWindowDuration, Mode=TwoWay}"
            />
            <TextBlock
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="ms"
            />
          </StackPanel>
          <TextBlock
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind lang:Lang.AppearanceSetting_InfoWindowDurationDesc}"
            TextWrapping="Wrap"
          />
          <ToggleSwitch
            Margin="0,12,0,0"
            IsOn="{x:Bind MuteNotificationInFullscreen, Mode=TwoWay}"
            OffContent="{x:Bind lang:Lang.Starshot_MuteNotificationInFullscreen}"
            OnContent="{x:Bind lang:Lang.Starshot_MuteNotificationInFullscreen}"
          />
          <TextBlock
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind lang:Lang.Starshot_MuteNotificationInFullscreenDesc}"
            TextWrapping="Wrap"
          />
          <ToggleSwitch
            Margin="0,12,0,0"
            IsOn="{x:Bind HideInfoWindowFromCapture, Mode=TwoWay}"
            OffContent="{x:Bind lang:Lang.AppearanceSetting_HideInfoWindowFromCapture}"
            OnContent="{x:Bind lang:Lang.AppearanceSetting_HideInfoWindowFromCapture}"
          />
          <TextBlock
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind lang:Lang.AppearanceSetting_HideInfoWindowFromCaptureDesc}"
            TextWrapping="Wrap"
          />
        </StackPanel>
      </StackPanel>

      <!--  OCR 文字识别  -->
      <StackPanel Spacing="12">
        <TextBlock FontSize="20" Text="{x:Bind lang:Lang.ScreenshotSetting_OcrEngine}" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button
            Click="Button_OcrEngineConfig_Click"
            Content="{x:Bind lang:Lang.ScreenshotSetting_OcrEngineConfigButton}"
          />
          <TextBlock
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind lang:Lang.ScreenshotSetting_OcrEngineDesc}"
            TextWrapping="Wrap"
          />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</sf:PageBase>
