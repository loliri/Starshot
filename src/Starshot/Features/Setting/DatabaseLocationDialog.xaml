<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Starshot.Features.Setting.DatabaseLocationDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:lang="using:Starshot.Language"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               x:DefaultBindMode="OneWay"
               Background="{ThemeResource CustomAcrylicBrush}"
               BorderThickness="0"
               CornerRadius="8"
               Style="{ThemeResource DefaultContentDialogStyle}"
               mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <StaticResource x:Key="ContentDialogSmokeFill" ResourceKey="ControlFillColorTransparentBrush" />
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="ControlFillColorTransparentBrush" />
    </ContentDialog.Resources>

    <Grid Width="480" MinHeight="200">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Margin="24,24,0,12"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="{x:Bind lang:Lang.Starshot_DatabaseLocationChangedTitle}" />

        <TextBlock Grid.Row="1"
                   Margin="24,0,24,0"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind lang:Lang.Starshot_DatabaseLocationChangedMessage}"
                   TextWrapping="Wrap" />

        <Button Grid.Row="2"
                Margin="24"
                HorizontalAlignment="Right"
                Click="Button_Apply_Click"
                Content="{x:Bind lang:Lang.Common_Apply}"
                Style="{ThemeResource AccentButtonStyle}" />

    </Grid>

</ContentDialog>
