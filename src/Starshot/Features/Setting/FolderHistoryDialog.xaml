<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
  x:Class="Starshot.Features.Setting.FolderHistoryDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:lang="using:Starshot.Language"
  xmlns:local="using:Starshot.Features.Setting"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  x:DefaultBindMode="OneWay"
  Background="{ThemeResource CustomAcrylicBrush}"
  BorderThickness="0"
  CornerRadius="8"
  Style="{ThemeResource DefaultContentDialogStyle}"
  mc:Ignorable="d"
>
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
    <Thickness x:Key="ContentDialogPadding">0</Thickness>
    <StaticResource x:Key="ContentDialogSmokeFill" ResourceKey="ControlFillColorTransparentBrush" />
    <StaticResource
      x:Key="ContentDialogTopOverlay"
      ResourceKey="ControlFillColorTransparentBrush"
    />
  </ContentDialog.Resources>

  <Grid MinWidth="480" MinHeight="200">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--  标题（自绘：ContentDialog.Title 渲染在内容区外贴角无边距）  -->
    <TextBlock
      x:Name="TextBlock_Title"
      Margin="24,24,0,12"
      FontSize="20"
      Text="" />

    <ListView
      Grid.Row="1"
      Padding="12,8,12,0"
      ItemsSource="{x:Bind Items}"
      SelectionMode="None"
    >
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:FolderHistoryItem">
          <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="32" />
              <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <TextBlock
              VerticalAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="{x:Bind Path}"
              TextTrimming="CharacterEllipsis"
              ToolTipService.ToolTip="{x:Bind Path}"
            />
            <Button
              Grid.Column="1"
              Width="32"
              Height="32"
              Padding="0"
              Click="Button_Open_Click"
              Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
              ToolTipService.ToolTip="{x:Bind lang:Lang.Common_Open}"
              Visibility="{x:Bind Exists}"
            >
              <FontIcon
                FontSize="16"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE8A7;"
                IsTextScaleFactorEnabled="False"
              />
            </Button>
            <Button
              Grid.Column="2"
              Width="32"
              Height="32"
              Padding="0"
              Click="Button_Delete_Click"
              Style="{ThemeResource DateTimePickerFlyoutButtonStyle}"
              ToolTipService.ToolTip="{x:Bind lang:Lang.Common_Delete}"
            >
              <FontIcon
                FontSize="16"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE74D;"
                IsTextScaleFactorEnabled="False"
              />
            </Button>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <TextBlock
      Grid.Row="1"
      Margin="24,24,24,12"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
      Text="{x:Bind lang:Lang.Starshot_FolderHistoryEmpty}"
      Visibility="{x:Bind HasNoItems}"
    />

    <!--  恢复默认 / 关闭  -->
    <StackPanel
      Grid.Row="2"
      Margin="24,12,24,16"
      HorizontalAlignment="Right"
      Orientation="Horizontal"
      Spacing="12"
    >
      <Button Click="Button_Reset_Click" Content="{x:Bind lang:Lang.Starshot_ResetToDefault}" />
      <Button
        Click="Button_Close_Click"
        Content="{x:Bind lang:Lang.Common_OK}"
        Style="{ThemeResource AccentButtonStyle}"
      />
    </StackPanel>
  </Grid>
</ContentDialog>
